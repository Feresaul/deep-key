{
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,

        "rootDir": "lib",
        "outDir": "dist",
        "declaration": true,
        "declarationDir": "dist"
    },
    "include": ["lib/**/*"]
}
