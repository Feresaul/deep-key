{
    "name": "@nuc-lib/deep-key",
    "version": "2.0.2",
    "description": "Utility to work with deep keys in objects.",
    "author": "Esaúl Franco",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write .",
        "test": "vitest --run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Feresaul/deep-key.git"
    },
    "keywords": [
        "@nuc-lib",
        "typescript",
        "utility",
        "deep",
        "key",
        "object",
        "nested",
        "property"
    ],
    "homepage": "https://github.com/Feresaul/deep-key#readme",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "ts-node": "^10.9.2",
        "typescript-eslint": "^8.58.0",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    }
}
